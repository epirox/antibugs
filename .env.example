# ──────────────────────────────────────────────────────────────
# Variables de entorno para docker-compose. Copiar a `.env`:
#   cp .env.example .env
#
# ⚠️  Los valores de APP_KEY y JWT_SECRET son SÓLO para desarrollo.
#     En producción generar nuevos con:
#       php artisan key:generate --show
#       php artisan jwt:secret --show
# ──────────────────────────────────────────────────────────────

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:JL+RBuF6ay3TeNIrZDgpyK1wkMlpTI+gHZS8ap2zL5c=
JWT_SECRET=dev-only-change-me-ZkqWpT3vY8sB1nC6xR9uH2mL4dF7gJ0a
JWT_TTL=60

# Puertos publicados en el host
FRONTEND_PORT=80
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

# Base de datos
DB_DATABASE=antibugs
DB_USERNAME=antibugs
DB_PASSWORD=antibugs
DB_ROOT_PASSWORD=root

# Carga usuarios/categorías/tickets de demostración al iniciar
SEED_DATABASE=true

# Logs
LOG_LEVEL=info

# Grafana (perfil observability)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Tag de las imágenes (CI/CD lo reemplaza por el SHA del commit → imágenes inmutables)
IMAGE_TAG=local
